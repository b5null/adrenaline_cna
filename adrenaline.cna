sub ad_help_firewall_rule {
    blog($1, "\nCommand: ad_firewall_rule\n" .
        "Summary: Add, remove, query, or list Windows Firewall rules through INetFwPolicy2 COM.\n" .
        "Usage:   ad_firewall_rule list\n" .
        "         ad_firewall_rule query <name>\n" .
        "         ad_firewall_rule remove <name>\n" .
        "         ad_firewall_rule add <name> <dir> <action> <protocol> [localport] [remoteport] [profile]\n" .
        "         name       - Rule name.\n" .
        "         dir        - in or out.\n" .
        "         action     - allow or block.\n" .
        "         protocol   - tcp, udp, or any.\n" .
        "         localport  - Required for tcp/udp. Omit or empty for any.\n" .
        "         remoteport - Optional remote port.\n" .
        "         profile    - Optional. domain, private, public, or all. Default: all.\n");
}

sub ad_help_port_scan {
    blog($1, "\nCommand: ad_port_scan\n" .
        "Summary: Perform a bounded IPv4 TCP/UDP port scan against one host.\n" .
        "Usage:   ad_port_scan <target> [ports] [protocol] [timeout_ms]\n" .
        "         target      - Required IPv4 address or resolvable hostname.\n" .
        "         ports       - Optional. top20, top100, port, comma list, or start-end. Default: top20.\n" .
        "         protocol    - Optional. 0=tcp, 1=udp, 2=both. Default: 0.\n" .
        "         timeout_ms  - Optional per-port timeout, 1-30000. Default: 1000.\n");
}

sub ad_help_service_control {
    blog($1, "\nCommand: ad_service_control\n" .
        "Summary: Manage local Windows services through the Service Control Manager.\n" .
        "Usage:   ad_service_control query [service_name]\n" .
        "         ad_service_control create <service_name> <bin_path> [display_name] [start_type] [service_type] [error_control]\n" .
        "         ad_service_control start <service_name>\n" .
        "         ad_service_control stop <service_name>\n" .
        "         ad_service_control delete <service_name>\n" .
        "         ad_service_control failure <service_name> <reset_seconds> [reboot_msg] [command] [actions]\n" .
        "         start_type     - Optional raw Windows dwStartType constant.\n" .
        "         service_type   - Optional raw Windows dwServiceType constant.\n" .
        "         error_control  - Optional raw Windows dwErrorControl constant.\n" .
        "         actions        - Optional comma-separated type:delay_ms values: restart, reboot, run, none.\n" .
        "Note:    Create/delete/start/stop/failure changes usually require elevated rights.\n");
}

