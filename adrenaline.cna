alias ad_notepad_grab {
    @_ = flatten(@_);
    local('$count');

    $count = size(@_) - 1;
    if ($count == 0 || ad_is_help_arg($2)) {
        ad_help_notepad_grab($1);
        return;
    }
    if (lc($2) eq "run") {
        if ($count != 1) {
            ad_help_notepad_grab($1);
            return;
        }
        ad_run($1, "community/notepad_grab/notepad_grab", "notepad_grab", "");
        return;
    }
    if ($count != 1) {
        ad_help_notepad_grab($1);
        return;
    }

    ad_run($1, "community/notepad_grab/notepad_grab", "notepad_grab", ad_pack_z(@_));
}

