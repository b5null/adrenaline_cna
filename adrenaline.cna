# Adrenaline BOF Kit - Cobalt Strike Aggressor loader
#
# Load from Cobalt Strike: Script Manager -> Load -> adrenaline.cna
# All Beacon aliases are prefixed with ad_ to avoid collisions.

sub ad_bof_path {
    local('$bid $base $barch $path');

    $bid   = $1;
    $base  = $2;
    $barch = barch($bid);
    $path  = script_resource($base . "." . $barch . ".o");

    if (-exists $path) {
        return $path;
    }

    berror($bid, "Adrenaline: missing BOF for " . $barch . " Beacon: " . $base . "." . $barch . ".o");
    return "";
}

sub ad_read_bof {
    local('$bid $base $path $handle $data');

    $bid  = $1;
    $base = $2;
    $path = ad_bof_path($bid, $base);

    if ($path eq "") {
        return "";
    }

    $handle = openf($path);
    $data   = readb($handle, -1);
    closef($handle);

    return $data;
}

sub ad_run {
    local('$bid $base $description $args $data');

    $bid         = $1;
    $base        = $2;
    $description = $3;
    $args        = $4;
    $data        = ad_read_bof($bid, $base);

    if ($data eq "") {
        return;
    }

    btask($bid, "Adrenaline BOF: " . $description);
    beacon_inline_execute($bid, $data, "go", $args);
}

sub ad_pack_z {
    @_ = flatten(@_);
    local('$bid $count');

    $bid   = $1;
    $count = size(@_) - 1;

    if ($count == 0) { return ""; }
    if ($count == 1) { return bof_pack($bid, "z", $2); }
    if ($count == 2) { return bof_pack($bid, "zz", $2, $3); }
    if ($count == 3) { return bof_pack($bid, "zzz", $2, $3, $4); }
    if ($count == 4) { return bof_pack($bid, "zzzz", $2, $3, $4, $5); }
    if ($count == 5) { return bof_pack($bid, "zzzzz", $2, $3, $4, $5, $6); }
    if ($count == 6) { return bof_pack($bid, "zzzzzz", $2, $3, $4, $5, $6, $7); }
    if ($count == 7) { return bof_pack($bid, "zzzzzzz", $2, $3, $4, $5, $6, $7, $8); }
    if ($count == 8) { return bof_pack($bid, "zzzzzzzz", $2, $3, $4, $5, $6, $7, $8, $9); }

    berror($bid, "Adrenaline: this alias supports up to 8 string arguments");
    return "";
}

sub ad_pack_Z {
    @_ = flatten(@_);
    local('$bid $count');

    $bid   = $1;
    $count = size(@_) - 1;

    if ($count == 0) { return ""; }
    if ($count == 1) { return bof_pack($bid, "Z", $2); }
    if ($count == 2) { return bof_pack($bid, "ZZ", $2, $3); }
    if ($count == 3) { return bof_pack($bid, "ZZZ", $2, $3, $4); }
    if ($count == 4) { return bof_pack($bid, "ZZZZ", $2, $3, $4, $5); }

    berror($bid, "Adrenaline: this alias supports up to 4 wide-string arguments");
    return "";
}

sub ad_usage {
    blog($1, $2);
}

sub ad_is_help_arg {
    local('$arg');

    $arg = lc($1);
    return ($arg eq "help" || $arg eq "-h" || $arg eq "--help" || $arg eq "/h" || $arg eq "/?" || $arg eq "?");
}

sub ad_help_notepad_grab {
    blog($1, "\nCommand: ad_notepad_grab\n" .
        "Summary: Extract text from open Notepad windows, optionally matching a title.\n" .
        "Usage:   ad_notepad_grab run\n" .
        "         ad_notepad_grab <title_filter>\n" .
        "         run           - Execute without a title filter.\n" .
        "         title_filter  - Optional. Only return text from windows whose title matches.\n");
}

sub ad_help_schtask_enum {
    blog($1, "\nCommand: ad_schtask_enum\n" .
        "Summary: Enumerate scheduled tasks through the Task Scheduler COM interface.\n" .
        "Usage:   ad_schtask_enum local\n" .
        "         ad_schtask_enum <server>\n" .
        "         local   - Enumerate scheduled tasks on the current host.\n" .
        "         server  - Optional. Remote host to query. Omit for local enumeration.\n" .
        "Note:    Remote enumeration depends on COM/RPC reachability and token rights.\n");
}

sub ad_help_net_use {
    blog($1, "\nCommand: ad_net_use\n" .
        "Summary: Add, list, or delete mapped network resources through MPR/WNet APIs.\n" .
        "Usage:   ad_net_use list [target]\n" .
        "         ad_net_use add <unc_share> [username] [password] [device] [persist] [require_privacy]\n" .
        "         ad_net_use delete <target> [persist] [force]\n" .
        "         target           - Optional local drive or remote UNC for list; required for delete.\n" .
        "         unc_share        - UNC path, for example \\\\fileserver\\share.\n" .
        "         username         - Optional DOMAIN\\user credential context.\n" .
        "         password         - Optional password for username.\n" .
        "         device           - Optional local drive, for example Z:. Empty uses auto assignment.\n" .
        "         persist          - Optional. 0 or 1. Default: 0.\n" .
        "         require_privacy  - Optional. 0 or 1. Requests CONNECT_ENCRYPTED. Default: 0.\n" .
        "         force            - Optional. 0 or 1. Default: 0.\n");
}

sub ad_help_certstore_loot {
    blog($1, "\nCommand: ad_certstore_loot\n" .
        "Summary: Enumerate certificate stores for exportable private keys.\n" .
        "Usage:   ad_certstore_loot all\n" .
        "         ad_certstore_loot <store_name> <location>\n" .
        "         all         - Scan default store set.\n" .
        "         store_name  - Optional. MY, CA, ROOT, Disallowed, TrustedPeople, or SmartCardRoot.\n" .
        "         location    - Optional. CurrentUser or LocalMachine.\n" .
        "Note:    Provide both optional values together, or provide neither to scan defaults.\n");
}

sub ad_help_cicd_credential_hunt {
    blog($1, "\nCommand: ad_cicd_credential_hunt\n" .
        "Summary: Find common CI/CD and developer credential artifacts under the current user profile.\n" .
        "Usage:   ad_cicd_credential_hunt presence\n" .
        "         ad_cicd_credential_hunt verbose\n" .
        "         presence - Report paths and sizes only. Default BOF mode.\n" .
        "         verbose  - Optional. Reads bounded previews. Presence mode is the default.\n" .
        "Note:    Presence mode avoids printing token-like file content to Beacon output.\n");
}

sub ad_help_cloud_metadata_check {
    blog($1, "\nCommand: ad_cloud_metadata_check\n" .
        "Summary: Probe AWS, Azure, GCP, App Service, and Azure Arc metadata/identity paths.\n" .
        "Usage:   ad_cloud_metadata_check full\n" .
        "         ad_cloud_metadata_check presence [-aud arm|graph|other:<resource>|other <resource>]\n" .
        "         ad_cloud_metadata_check -aud arm|graph|other:<resource>|other <resource>\n" .
        "         full              - Full default output, including bounded credential snippets.\n" .
        "         presence          - Optional. Report exposure/context without credential snippets.\n" .
        "         -aud arm          - Optional. Azure Resource Manager audience. Default.\n" .
        "         -aud graph        - Optional. Microsoft Graph audience.\n" .
        "         -aud other:<res>  - Optional. Custom Azure audience/resource.\n" .
        "Note:    Run presence first when you do not want credential snippets in output.\n");
}

sub ad_help_process_tokens_list {
    blog($1, "\nCommand: ad_process_tokens_list\n" .
        "Summary: Enumerate accessible process tokens with optional PID/process filtering.\n" .
        "Usage:   ad_process_tokens_list all\n" .
        "         ad_process_tokens_list [pid|process_name] [/debug|/enablesebug]\n" .
        "         ad_process_tokens_list [/debug|/enablesebug] [pid|process_name]\n" .
        "         all               - Enumerate accessible tokens without a filter.\n" .
        "         pid|process_name  - Optional filter.\n" .
        "         /debug           - Optional. Attempts to enable SeDebugPrivilege.\n" .
        "Note:    SeDebugPrivilege is disabled by default for OPSEC.\n");
}

