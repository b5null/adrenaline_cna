    ad_run($1, "discovery/wallpaper_enum/wallpaper_enum", "wallpaper_enum", "");
}

alias ad_wef_detect {
    ad_run($1, "discovery/wef_detect/wef_detect", "wef_detect", "");
}

alias ad_window_list {
    @_ = flatten(@_);
    local('$count');

    $count = size(@_) - 1;
    if ($count == 0 || ad_is_help_arg($2)) {
        ad_help_window_list($1);
        return;
    }
    if (lc($2) eq "titles") {
        if ($count != 1) {
            ad_help_window_list($1);
            return;
        }
        ad_run($1, "discovery/window_list/window_list", "window_list", "");
        return;
    }
    if ($count != 1) {
        ad_help_window_list($1);
        return;
    }

    ad_run($1, "discovery/window_list/window_list", "window_list", ad_pack_z(@_));
}

alias ad_win_version {
    ad_run($1, "discovery/win_version/win_version", "win_version", "");
}

alias ad_wsc_status {
    ad_run($1, "discovery/wsc_status/wsc_status", "wsc_status", "");
}

alias ad_com_probe {
    @_ = flatten(@_);
    local('$count');

    $count = size(@_) - 1;
    if (ad_is_help_arg($2)) {
        ad_help_com_probe($1);
        return;
    }
    if ($count < 1 || $count > 2) {
        ad_help_com_probe($1);
        return;
    }

    ad_run($1, "execution/com_probe/com_probe", "com_probe", ad_pack_z(@_));
}

alias ad_firewall_rule {
    @_ = flatten(@_);
    local('$count');

    $count = size(@_) - 1;
    if (ad_is_help_arg($2)) {
        ad_help_firewall_rule($1);
        return;
    }
    if ($count < 1) {
        ad_help_firewall_rule($1);
        return;
    }

    ad_run($1, "execution/firewall_rule/firewall_rule", "firewall_rule", ad_pack_z(@_));
}

alias ad_port_scan {
    @_ = flatten(@_);
    local('$count $args $protocol $timeout');

    $count = size(@_) - 1;
    if (ad_is_help_arg($2)) {
        ad_help_port_scan($1);
        return;
    }
    if ($count < 1) {
        ad_help_port_scan($1);
        return;
    }
    if ($count > 4) {
        ad_help_port_scan($1);
        return;
    }

    if ($count == 1) {
        $args = bof_pack($1, "z", $2);
    } else if ($count == 2) {
        $args = bof_pack($1, "zz", $2, $3);
    } else if ($count == 3) {
        $protocol = $4;
        $args = bof_pack($1, "zzs", $2, $3, $protocol);
    } else {
        $protocol = $4;
        $timeout  = $5;
        $args = bof_pack($1, "zzsi", $2, $3, $protocol, $timeout);
    }

    ad_run($1, "execution/port_scan/port_scan", "port_scan", $args);
}

alias ad_service_control {
    @_ = flatten(@_);
    local('$count $subcmd $args');

    $count = size(@_) - 1;
    if (ad_is_help_arg($2)) {
        ad_help_service_control($1);
        return;
    }
    if ($count < 1) {
        ad_help_service_control($1);
        return;
    }

    $subcmd = lc($2);

    if ($subcmd eq "query") {
        if ($count > 2) {
            ad_help_service_control($1);
            return;
        }

        if ($count == 1) {
            $args = bof_pack($1, "Z", $2);
        } else {
            $args = bof_pack($1, "ZZ", $2, $3);
        }
        ad_run($1, "execution/service_control/service_control", "service_control query", $args);
        return;
    }

    if ($subcmd eq "start" || $subcmd eq "stop" || $subcmd eq "delete") {
        if ($count != 2) {
            ad_help_service_control($1);
            return;
        }
        $args = bof_pack($1, "ZZ", $2, $3);
        ad_run($1, "execution/service_control/service_control", "service_control " . $subcmd, $args);
        return;
    }

    if ($subcmd eq "create") {
        if ($count < 3) {
            ad_help_service_control($1);
            return;
        }
        if ($count > 7) {
            ad_help_service_control($1);
            return;
        }

        if ($count == 3) {
            $args = bof_pack($1, "ZZZ", $2, $3, $4);
        } else if ($count == 4) {
            $args = bof_pack($1, "ZZZZ", $2, $3, $4, $5);
        } else if ($count == 5) {
            $args = bof_pack($1, "ZZZZi", $2, $3, $4, $5, $6);
        } else if ($count == 6) {
            $args = bof_pack($1, "ZZZZii", $2, $3, $4, $5, $6, $7);
        } else {
            $args = bof_pack($1, "ZZZZiii", $2, $3, $4, $5, $6, $7, $8);
        }

        ad_run($1, "execution/service_control/service_control", "service_control create", $args);
        return;
    }

    if ($subcmd eq "failure") {
        if ($count < 3) {
            ad_help_service_control($1);
            return;
        }
        if ($count > 6) {
            ad_help_service_control($1);
            return;
        }

        if ($count == 3) {
            $args = bof_pack($1, "ZZi", $2, $3, $4);
        } else if ($count == 4) {
            $args = bof_pack($1, "ZZiZ", $2, $3, $4, $5);
        } else if ($count == 5) {
            $args = bof_pack($1, "ZZiZZ", $2, $3, $4, $5, $6);
        } else {
            $args = bof_pack($1, "ZZiZZZ", $2, $3, $4, $5, $6, $7);
        }

        ad_run($1, "execution/service_control/service_control", "service_control failure", $args);
        return;
    }

    ad_help_service_control($1);
}

alias ad_wevt_logon_enum {
    ad_run($1, "execution/wevt_logon_enum/wevt_logon_enum", "wevt_logon_enum", "");
}

