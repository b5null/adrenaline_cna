    blog($1, "\nAdrenaline BOF Kit\n\n" .
        "Command / Usage                                             Description\n" .
        "---------------                                             -----------\n" .
        "ad_ai_surface                                               Map AI developer tooling and config artifacts\n" .
        "ad_clipboard_grab                                           Return current clipboard text\n" .
        "ad_ide_extension_surface                                    Enumerate developer editor extensions\n" .
        "ad_powershell_history                                       Collect PSReadLine and transcript artifacts\n" .
        "ad_window_handles_enum                                      Enumerate window handles and clipboard access surface\n" .
        "ad_net_use <list|add|delete> ...                            Add, list, or delete mapped drives through MPR\n" .
        "ad_notepad_grab <run|title_filter>                          Extract text from open Notepad windows\n" .
        "ad_schtask_enum <local|server>                               Enumerate scheduled tasks locally or remotely\n" .
        "ad_session_view                                             Enumerate Terminal Services sessions\n" .
        "ad_certstore_loot <all|store_name location>                  Find exportable certificates in local stores\n" .
        "ad_cicd_credential_hunt <presence|verbose>                  Find CI/CD and developer credential artifacts\n" .
        "ad_cloud_metadata_check <full|presence|-aud ...>            Probe cloud metadata and identity endpoints\n" .
        "ad_process_tokens_list <all|pid|process> [/debug]           Enumerate accessible process tokens\n" .
        "ad_amsi_etw_detect                                          Detect AMSI and ETW presence in the current process\n" .
        "ad_app_count                                                Count installed applications\n" .
        "ad_applocker_policy                                         Enumerate AppLocker policy configuration\n" .
        "ad_asr_status                                               Enumerate Defender ASR rule state\n" .
        "ad_bitlocker_status                                         Enumerate BitLocker status and policy configuration\n" .
        "ad_mdm_policy_artifacts                                     Score Windows MDM enrollment posture\n" .
        "ad_netjoin_query                                            Query Windows domain/workgroup join state\n" .
        "ad_power_state                                              Infer host form factor\n" .
        "ad_proxy_enum                                               Enumerate proxy configuration state\n" .
        "ad_tray_scout <normal|verbose>                              Enumerate system tray notification icons\n" .
        "ad_user_idle                                                Report user idle time and GUI handle usage\n" .
        "ad_wallpaper_enum                                           Enumerate current desktop wallpaper paths\n" .
        "ad_wef_detect                                               Detect Windows Event Forwarding configuration\n" .
        "ad_window_list <titles|/pid>                                List visible desktop windows\n" .
        "ad_win_version                                              Report concise Windows version information\n" .
        "ad_wsc_status                                               Query Windows Security Center health state\n" .
        "ad_com_probe <CLSID> [IID]                                  Probe COM class instantiation by CLSID\n" .
        "ad_firewall_rule <add|remove|query|list> ...                Manage Windows Firewall rules through COM\n" .
        "ad_port_scan <target> [ports] [protocol] [timeout_ms]       Bounded IPv4 TCP/UDP port scan against one host\n" .
        "ad_service_control <query|create|start|stop|delete|failure> Manage local Windows services through SCM\n" .
        "ad_wevt_logon_enum                                          Enumerate recent Security log logon events\n" .
        "\nRun an argument-aware command without arguments for its syntax card.\n" .
        "Examples: ad_port_scan, ad_process_tokens_list, ad_service_control\n");
}

