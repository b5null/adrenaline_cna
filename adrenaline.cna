alias ad_net_use {
    @_ = flatten(@_);
    local('$count $subcmd $args $persist $privacy $force');

    $count = size(@_) - 1;

    if ($count == 0 || ad_is_help_arg($2)) {
        ad_help_net_use($1);
        return;
    }

    $subcmd = lc($2);

    if ($subcmd eq "list") {
        if ($count > 2) {
            ad_help_net_use($1);
            return;
        }

        if ($count == 1) {
            $args = bof_pack($1, "sZ", 2, "");
        } else {
            $args = bof_pack($1, "sZ", 2, $3);
        }
        ad_run($1, "community/net_use/net_use", "net_use list", $args);
        return;
    }

    if ($subcmd eq "add") {
        if ($count < 2) {
            ad_help_net_use($1);
            return;
        }
        if ($count > 7) {
            ad_help_net_use($1);
            return;
        }

        $persist = 0;
        $privacy = 0;
        if ($7 ne "") {
            $persist = $7;
        }
        if ($8 ne "") {
            $privacy = $8;
        }
        $args = bof_pack($1, "sZZZZss", 1, $3, $4, $5, $6, $persist, $privacy);
        ad_run($1, "community/net_use/net_use", "net_use add", $args);
        return;
    }

    if ($subcmd eq "delete" || $subcmd eq "del" || $subcmd eq "remove") {
        if ($count < 2) {
            ad_help_net_use($1);
            return;
        }
        if ($count > 4) {
            ad_help_net_use($1);
            return;
        }

        $persist = 0;
        $force   = 0;
        if ($4 ne "") {
            $persist = $4;
        }
        if ($5 ne "") {
            $force = $5;
        }
        $args = bof_pack($1, "sZss", 3, $3, $persist, $force);
        ad_run($1, "community/net_use/net_use", "net_use delete", $args);
        return;
    }

    ad_help_net_use($1);
}

